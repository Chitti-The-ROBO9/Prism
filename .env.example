# Optional: without this key, Prism runs in polished demo mode with a sample analysis.
OPENAI_API_KEY=
# Leave this as GPT-5.6 for the hackathon, or override only if your account uses a different model ID.
PRISM_OPENAI_MODEL=gpt-5.6
# Optional: set this after deploying, for canonical SEO and social links.
NEXT_PUBLIC_SITE_URL=https://your-prism-domain.vercel.app
